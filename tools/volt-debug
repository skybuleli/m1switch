#!/usr/bin/env python3
"""
volt-debug: M1Switch 远程调试 CLI
连接 DebugServer Unix socket，发送 JSON-RPC 命令。

用法:
  python3 volt-debug                          # 交互模式
  python3 volt-debug --cmd "svc_trace 50"     # 单命令
  python3 volt-debug --cmd "stats"             # 查看 trace 统计
  python3 volt-debug --cmd "help"              # 帮助
"""

import argparse
import json
import socket
import sys
import readline

SOCKET_PATH = "/tmp/m1switch_debug.sock"


def send_command(sock, cmd_str: str) -> dict:
    """发送 JSON 命令并接收响应"""
    # 解析命令字符串为 JSON
    parts = cmd_str.strip().split()
    if not parts:
        return {"success": False, "error": "空命令"}

    cmd = parts[0]
    args = parts[1:] if len(parts) > 1 else []

    request = {"cmd": cmd, "args": args}
    request_json = json.dumps(request) + "\n"

    try:
        sock.sendall(request_json.encode("utf-8"))
    except (BrokenPipeError, ConnectionResetError):
        return {"success": False, "error": "连接断开"}

    # 读取响应 (一行 JSON)
    response_data = b""
    while True:
        try:
            chunk = sock.recv(4096)
            if not chunk:
                break
            response_data += chunk
            if b"\n" in response_data:
                break
        except socket.timeout:
            break

    if not response_data:
        return {"success": False, "error": "无响应"}

    try:
        return json.loads(response_data.decode("utf-8").strip())
    except json.JSONDecodeError:
        return {"success": False, "error": f"解析响应失败: {response_data[:200]}"}


def format_response(resp: dict) -> str:
    """格式化响应为可读输出"""
    if not resp.get("success", True):
        return f"❌ {resp.get('error', '未知错误')}"

    data = resp.get("data", "")
    if isinstance(data, str):
        try:
            parsed = json.loads(data)
            return json.dumps(parsed, indent=2, ensure_ascii=False)
        except (json.JSONDecodeError, TypeError):
            return data
    return json.dumps(resp, indent=2, ensure_ascii=False)


def interactive_mode(sock):
    """交互式命令行"""
    print("volt-debug — M1Switch 远程调试 CLI")
    print(f"连接: {SOCKET_PATH}")
    print("输入 help 查看命令列表，输入 exit 退出\n")

    while True:
        try:
            cmd_str = input("debug> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n退出")
            break

        if cmd_str in ("exit", "quit", "q"):
            break

        if not cmd_str:
            continue

        resp = send_command(sock, cmd_str)
        print(format_response(resp))


def main():
    parser = argparse.ArgumentParser(description="volt-debug: M1Switch 远程调试 CLI")
    parser.add_argument("--cmd", help="单命令模式")
    parser.add_argument("--socket", default=SOCKET_PATH, help="Unix socket 路径")
    args = parser.parse_args()

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(args.socket)
    except ConnectionRefusedError:
        print(f"无法连接 {args.socket}，模拟器是否在运行？")
        sys.exit(1)
    except FileNotFoundError:
        print(f"Socket 文件不存在: {args.socket}")
        sys.exit(1)

    sock.settimeout(5.0)

    if args.cmd:
        resp = send_command(sock, args.cmd)
        print(format_response(resp))
    else:
        interactive_mode(sock)

    sock.close()


if __name__ == "__main__":
    main()