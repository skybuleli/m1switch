{
  "project": "m1switch",
  "version": "0.1.0",
  "toolchain": {
    "cmake": "3.20+",
    "compiler": "AppleClang 15+ (arm64)",
    "build_command": "cmake --build build --config Release",
    "test_command": "cmake --build build && ./build/m1switch_headless"
  },
  "milestones": {
    "m0": {
      "name": "Engineering Foundation",
      "description": "Build system, logging, config, Metal device init, AppKit skeleton",
      "depends_on": [],
      "tests": ["t0.1", "t0.2"],
      "acceptance": {
        "min_tests_pass": 2,
        "build_succeeds": true
      }
    },
    "m1": {
      "name": "PLASTIC",
      "description": "CPU native execution, memory mapping, SVC dispatch",
      "depends_on": ["m0"],
      "tests": ["t1.1", "t1.2", "t1.3"],
      "acceptance": {
        "min_tests_pass": 3,
        "svc_dispatch_works": true
      }
    },
    "m2": {
      "name": "COPPER",
      "description": "HLE services (SM, FS, NV, HID, VI) + IPC",
      "depends_on": ["m1"],
      "tests": ["t2.1", "t2.2", "t2.3"],
      "acceptance": {
        "min_tests_pass": 3,
        "ipc_roundtrip_works": true
      }
    },
    "m3_5": {
      "name": "E2E NRO Test Suite",
      "description": "L0 assembly NRO tests via devkitPro",
      "depends_on": ["m3"],
      "tests": ["t3.5.1", "t3.5.2", "t3.5.3", "t3.5.4", "t3.5.5"],
      "acceptance": {
        "min_tests_pass": 4,
        "nro_tests_exist": true
      }
    },
    "m3": {
      "name": "IRON",
      "description": "First triangle via Metal (GPU command parser, shader, renderer)",
      "depends_on": ["m2"],
      "tests": ["t3.1", "t3.2", "t3.3"],
      "acceptance": {
        "min_tests_pass": 3,
        "framebuffer_not_black": true
      }
    }
  },
  "tests": {
    "t0.1": {
      "name": "Build succeeds",
      "type": "build",
      "command": "cmake --build build --config Release",
      "expected": { "exit_code": 0 }
    },
    "t0.2": {
      "name": "Unit tests pass",
      "type": "unit",
      "command": "./build/m1switch_tests",
      "expected": { "exit_code": 0 }
    },
    "t1.1": {
      "name": "SVC ExitProcess",
      "type": "headless",
      "command": "./build/m1switch_headless test-roms/exit.nro --timeout=5",
      "expected": { "exit_code": 0, "output_contains": "GUEST EXITED NORMALLY" }
    },
    "t1.2": {
      "name": "Memory mapping",
      "type": "unit",
      "command": "./build/m1switch_tests --filter=Memory",
      "expected": { "exit_code": 0 }
    },
    "t1.3": {
      "name": "SVC dispatch",
      "type": "unit",
      "command": "./build/m1switch_tests --filter=Kernel",
      "expected": { "exit_code": 0 }
    },
    "t2.1": {
      "name": "IPC Service Discovery",
      "type": "headless",
      "command": "./build/m1switch_headless test-roms/ipc_test.nro --timeout=10",
      "expected": { "exit_code": 0 }
    },
    "t2.2": {
      "name": "File system read",
      "type": "headless",
      "command": "./build/m1switch_headless test-roms/fs_test.nro --timeout=10",
      "expected": { "exit_code": 0 }
    },
    "t2.3": {
      "name": "GPU init",
      "type": "unit",
      "command": "./build/m1switch_tests --filter=Gpu",
      "expected": { "exit_code": 0 }
    },
    "t3.1": {
      "name": "Maxwell decoder",
      "type": "unit",
      "command": "./build/m1switch_tests --filter=MaxwellDecoder",
      "expected": { "exit_code": 0 }
    },
    "t3.2": {
      "name": "SPIR-V emission",
      "type": "unit",
      "command": "./build/m1switch_tests --filter=SpirvEmission",
      "expected": { "exit_code": 0 }
    },
    "t3.3": {
      "name": "Clear color",
      "type": "headless",
      "command": "./build/m1switch_headless test-roms/clear_red.nro --timeout=10",
      "expected": { "exit_code": 0 }
    }
  },
  "benchmarks": {
    "t3.5.1": {
      "name": "L0 svc_exit",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_svc_exit.nro --timeout=5",
      "expected": { "exit_code": 0, "output_contains": "GUEST EXITED NORMALLY" }
    },
    "t3.5.2": {
      "name": "L0 svc_heap",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_svc_heap.nro --timeout=5",
      "expected": { "exit_code": 0, "output_contains": "TEST_PASS:" }
    },
    "t3.5.3": {
      "name": "L0 svc_sleep",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_svc_sleep.nro --timeout=5",
      "expected": { "exit_code": 0, "output_contains": "TEST_PASS:" }
    },
    "t3.5.4": {
      "name": "L0 svc_output",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_svc_output.nro --timeout=5",
      "expected": { "exit_code": 0, "output_contains": "TEST_PASS:" }
    },
    "t3.5.5": {
      "name": "L0 svc_thread",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_svc_thread.nro --timeout=10",
      "expected": { "exit_code": 0, "output_contains": "TEST_PASS:" }
    },
    "t3.6.1": {
      "name": "L1 sm_getsrv",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_sm_getsrv.nro --timeout=10",
      "expected": { "exit_code": 0, "output_contains": "TEST_PASS:" }
    },
    "t3.6.2": {
      "name": "L1 set_sys",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_set_sys.nro --timeout=10",
      "expected": { "exit_code": 0, "output_contains": "TEST_PASS:" }
    },
    "t3.6.3": {
      "name": "L1 hid_npad",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_hid_npad.nro --timeout=10",
      "expected": { "exit_code": 0, "output_contains": "TEST_PASS:" }
    },
    "t3.6.4": {
      "name": "L1 vi_init",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_vi_init.nro --timeout=10",
      "expected": { "exit_code": 0, "output_contains": "TEST_PASS:" }
    },
      "name": "L0 svc_thread",
      "type": "headless",
      "command": "./build/m1switch_headless tests/e2e/build/test_svc_thread.nro --timeout=10",
      "expected": { "exit_code": 0, "output_contains": "TEST_PASS:" }
    },
    "b.svc.dispatch": {
      "name": "SVC dispatch roundtrip",
      "command": "./build/m1switch_headless test-roms/bench_svc.nro --timeout=10",
      "metric": "svc_per_second",
      "max_regression_pct": 15
    }
  }
}